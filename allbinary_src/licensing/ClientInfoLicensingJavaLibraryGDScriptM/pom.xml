        <planned.compiler>C:/Godot_v4.7.2-stable_mono_win64/Godot_v4.7.2-stable_mono_win64_console.exe</planned.compiler>
        <planned.compiler.flags></planned.compiler.flags>
        <planned.runtime.directory>G:/mnt/bc/mydev/workgdscript/j2me/J2SEForGDScriptLibraryGDScriptM/src/main/java</planned.runtime.directory>
        <planned.fail.on.error>true</planned.fail.on.error>
